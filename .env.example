NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
OPENAI_API_KEY=replace_me
OPENROUTER_API_KEY=replace_me

# Langfuse tracing (optional). Tracing is skipped when the keys are unset.
# Read by src/instrumentation.ts and src/lib/langfuseHandler.ts.
LANGFUSE_PUBLIC_KEY=replace_me
LANGFUSE_SECRET_KEY=replace_me
# Base URL of your Langfuse instance (self-hosted or https://cloud.langfuse.com)
LANGFUSE_BASEURL=http://localhost:3010
# Optional: URL used to build browser-clickable trace links when the server reaches
# Langfuse at a different address than the browser does. Defaults to LANGFUSE_BASEURL.
# LANGFUSE_PUBLIC_URL=https://langfuse.example.com
# Optional: project label shown in the Langfuse tab; defaults to zencub-rag
# LANGFUSE_PROJECT=zencub-rag

# Direct Postgres or pooler URL; this is not NEXT_PUBLIC_SUPABASE_URL.
LANGGRAPH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph
LANGGRAPH_TEST_MODE=off

RAG_ANALYZE_MODEL=gpt-4o-mini
RAG_ANSWER_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_RERANK_MODEL=gpt-4o-mini
RAG_OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507
# Optional override; defaults to https://openrouter.ai/api/v1
RAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set RAG_RERANK=off to disable the Ask reranker
RAG_RERANK=on
# Total targeted evidence-repair rounds shared by both Instructor Compare
# loop-back gates. Values are clamped to 0-3; production demo recommendation: 2.
RAG_COMPARE_MAX_REFINEMENT_ROUNDS=2
# Local model served through an OpenAI-compatible endpoint (for example Ollama)
RAG_QWEN_BASE_URL=http://localhost:11434/v1
RAG_QWEN_MODEL=qwen3.6:35b-mlx
# Optional local-CLI provider: Claude Code binary; empty model uses the CLI default
RAG_CLAUDE_BIN=claude
RAG_CLAUDE_MODEL=
# Safety guard: embed:chunks refuses to write unless the Supabase host matches this ref
RAG_TEST_PROJECT_REF=YOUR_PROJECT_REF

# --- instructors.zencub.com (APP_MODE=instructors) ---------------------------
# Which model runs the public comparison workflow. Pinned server-side and never
# read from a request: a comparison is about a dozen model calls, so `qwen`
# would hold the machine's only Ollama instance for roughly ten minutes a run.
RAG_INSTRUCTORS_PROVIDER=openai
# Site-wide ceiling on comparisons per day. Roughly $0.008 a run on gpt-4o-mini,
# so 500 is about $4/day. Search and the rest of the site stay up when it trips.
RAG_INSTRUCTORS_DAILY_BUDGET=500
# How many instructors the public panel asks for. Clamped to 2-5 by the graph.
RAG_INSTRUCTORS_PANEL_SIZE=5

# --- MCP server (mcp/) --------------------------------------------------------
# Dedicated read-only role with SELECT on schema rag_mcp and nothing else.
# Created by mcp/migrations/0001-rag-mcp-schema-and-reader-role.sql.
# Never point this at the service-role key or the owner connection string.
MCP_DATABASE_URL=postgresql://zencub_mcp_reader.YOUR_PROJECT_REF:replace_me@YOUR_POOLER_HOST:5432/postgres

# Model used by mcp/scripts/classify-content-kind.ts to label each video's
# content_kind. The script refuses to run without it rather than picking one.
# Any OpenAI-compatible endpoint; falls back to RAG_OPENROUTER_MODEL and to
# OPENROUTER_API_KEY. Not used by the MCP server itself, which holds no model
# credential at all.
CONTENT_KIND_MODEL=
# CONTENT_KIND_BASE_URL=https://openrouter.ai/api/v1
# CONTENT_KIND_API_KEY=
