<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: ZenCub instructor-comparison site on 127.0.0.1:3420 (APP_MODE=instructors), the third production surface from scripts/deploy/serve.sh alongside public :3418 and demo :3419. Answers run on OpenAI gpt-4o-mini rather than local Qwen, because a comparison is a dozen model calls and Qwen would hold the machine's only Ollama instance for ~10 minutes each. Capped at 500 comparisons a day (about $3); past that the page says so instead of failing oddly. Loopback-only, so the sole way in is the Cloudflare Tunnel. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.zencub-rag-instructors</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/elai/code/zencub-rag/scripts/deploy/serve.sh</string>
        <string>instructors</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/elai/code/zencub-rag</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardOutPath</key>
    <string>/Users/elai/Library/Logs/zencub-rag/instructors.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/elai/Library/Logs/zencub-rag/instructors.log</string>
</dict>
</plist>
