<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: Every 5 minutes, redeploys zencub-rag when origin/main has moved or the running servers are behind the checkout. Polls rather than exposing an inbound deploy endpoint, and logs only real deploys - a quiet log means idle, not stopped. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.zencub-rag-autodeploy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/elai/code/zencub-rag/scripts/deploy/autodeploy.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/elai/code/zencub-rag</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/elai/Library/Logs/zencub-rag/autodeploy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/elai/Library/Logs/zencub-rag/autodeploy.log</string>
</dict>
</plist>
