# Copy to scripts/deploy/prod.env (gitignored) before starting the demo server.
#
# DEMO_PIN     the PIN you hand out for demo.zencub.com
# DEMO_SECRET  HMAC key that signs the unlock cookie; rotating it logs everyone out.
#              Generate with: openssl rand -hex 32
#
# Both must be set or the demo deployment fails closed with a 503.

DEMO_PIN=000000
DEMO_SECRET=replace_me
# Shared total across Instructor Compare's evidence and final-quality loopbacks.
RAG_COMPARE_MAX_REFINEMENT_ROUNDS=2
