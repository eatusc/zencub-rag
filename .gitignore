# Local design reference export (not part of the shipped app)
design-mockup/

# Local machine run notes (port, setup) — not part of the shipped app
LOCAL.md

# Eval report dumps: contain verbatim third-party transcripts + project refs. Keep local, do not commit.
docs/evals/*.json

# ── Env files: never commit secrets ─────────────────────────────────────────
# Covers .env, .env.local, .env.production, and any suffixed copy
# (.env.local.bak, .env.local.from-lappy, ...). Templates stay tracked.
.env
.env.*
!.env.example

# Production build outputs for the two Cloudflare Tunnel deployments
.next-public/
.next-demo/

# Demo PIN + cookie secret for the full deployment
scripts/deploy/prod.env

# Held by scripts/deploy/deploy.sh while a deploy is in flight.
.deploy.lock/
